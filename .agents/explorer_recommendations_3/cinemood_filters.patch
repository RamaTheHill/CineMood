+  // Language / Region mapping
+  if (params.language && params.language !== 'any') {
+    const langMap = {
+      cis: 'ru|uk|be|kk',
+      en: 'en',
+      asia: 'ja|ko|zh',
+      eu: 'fr|it|de|es|da|sv|no|nl|pt|pl'
+    };
+    const targetLangs = langMap[params.language];
+    if (targetLangs && !ep.extra.with_origin_country) {
+      p.set('with_original_language', targetLangs);
+    }
+  }
+
   return `${TMDB_BASE}${ep.endpoint}?${p.toString()}`;
 }
